{
  "name": "odw",
  "version": "0.5.0",
  "description": "Open Dynamic Workflows: a TypeScript CLI runtime for Claude Code-style dynamic workflows across any coding-agent CLI.",
  "type": "module",
  "bin": {
    "odw": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "types",
    "conformance",
    "assets/odw-logo.png",
    "odw.config.example.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:web": "node web/build.mjs",
    "embed": "node scripts/embed-dashboard.mjs && node scripts/embed-templates.mjs && node scripts/generate-version.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean && npm run build:web && npm run embed",
    "build": "tsc -p tsconfig.json",
    "build:binary": "npm run build && node scripts/build-binary.mjs",
    "dev": "node scripts/generate-version.mjs && tsx src/cli.ts",
    "serve": "node scripts/generate-version.mjs && tsx src/cli.ts serve --open",
    "pretypecheck": "node scripts/generate-version.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "pretest": "node scripts/generate-version.mjs"
  },
  "workspaces": [
    "web"
  ],
  "keywords": [
    "open-dynamic-workflows",
    "open-dynamic-workflow",
    "dynamic-workflow",
    "dynamic-workflows",
    "agent-orchestration",
    "ai-agents",
    "multi-agent",
    "coding-agent",
    "claude-code",
    "codex",
    "typescript",
    "cli"
  ],
  "license": "MIT",
  "author": "Daniel Xing",
  "homepage": "https://github.com/xz1220/open-dynamic-workflows#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xz1220/open-dynamic-workflows.git"
  },
  "bugs": {
    "url": "https://github.com/xz1220/open-dynamic-workflows/issues"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
